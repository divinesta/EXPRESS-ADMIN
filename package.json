{
  "name": "prisma-express-admin",
  "version": "0.1.0",
  "description": "A Django-admin-like tool for Express + Prisma",
  "module": "src/index.ts",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --watch index.ts",
    "build": "bun run build:ui && bun build src/index.ts --outdir dist --target node",
    "build:ui": "bun run --cwd ui build",
    "test": "bun test",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "db:push": "prisma db push",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@prisma/adapter-pg": "7.5.0",
    "@types/bun": "latest",
    "@types/express": "^5.0.6",
    "@types/node": "^25.4.0",
    "@types/pg": "^8.20.0",
    "pg": "^8.22.0",
    "prisma": "^7.5.0"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@prisma/client": "^7.5.0",
    "@prisma/internals": "^7.5.0",
    "express": "^5.2.1"
  }
}
